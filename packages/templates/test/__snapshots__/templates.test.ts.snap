exports[`message renderers > renders stable Italian email and WhatsApp output 1`] = `
{
  "html": "<!doctype html>
<html lang="it">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Proposta di soggiorno — Hotel Sole</title></head>
<body style="margin:0;background:#f1f1f1;color:#202020;font-family:Poppins,Inter,Arial,sans-serif">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f1f1f1"><tr><td align="center" style="padding:24px 12px">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:#ffffff;border-radius:20px;overflow:hidden">
      <tr><td style="padding:32px 24px">
        <img src="https://cdn.example.com/logo.png" alt="Hotel Sole" width="64" style="display:block;max-width:64px;height:auto;margin-bottom:24px">
        <h1 style="margin:0 0 16px;font-size:24px;line-height:32px">Gentile Anna,</h1>
        <p style="margin:0 0 24px;font-size:16px;line-height:24px">abbiamo preparato la sua proposta di soggiorno personalizzata.</p>
        <div style="padding:20px;background:#edf3fc;border-radius:16px">
          <p style="margin:0 0 8px"><strong>Soggiorno:</strong> 10 gennaio 2027 – 12 gennaio 2027</p>
          <p style="margin:0 0 8px"><strong>Ospiti:</strong> 2 adulti, 1 bambino</p>
          <p style="margin:0"><strong>Totale soggiorno:</strong> 220,00 €</p>
        </div>
        <p style="margin:24px 0"><a href="https://offers.example.com/o/opaque-token" style="display:inline-block;padding:16px 24px;border-radius:12px;background:#1769ff;color:#ffffff;text-decoration:none;font-size:14px;font-weight:600">Vedi la proposta</a></p>
        <p style="margin:0;color:#4a4a4a;font-size:14px;line-height:20px">Saremo lieti di accoglierla.<br>Hotel Sole</p>
      </td></tr>
    </table>
  </td></tr></table>
</body></html>",
  "subject": "Proposta di soggiorno — Hotel Sole",
  "text": "Gentile Anna,

abbiamo preparato la sua proposta di soggiorno personalizzata.
Soggiorno: 10 gennaio 2027 – 12 gennaio 2027
Ospiti: 2 adulti, 1 bambino
Totale soggiorno: 220,00 €

Vedi la proposta: https://offers.example.com/o/opaque-token

Saremo lieti di accoglierla.
Hotel Sole",
  "whatsapp": "Gentile Anna,
la sua proposta di soggiorno personalizzata è pronta.
Soggiorno: 10 gennaio 2027 – 12 gennaio 2027
Totale soggiorno: 220,00 €
https://offers.example.com/o/opaque-token
Hotel Sole",
}
`;

exports[`public offer page > renders a stable mobile-first active page 1`] = `
"<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
  <meta name="referrer" content="no-referrer">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src https:; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'">
  <title>Proposta di soggiorno — Hotel Sole</title>
  <style>
    :root{--primary:#1769ff;--primary-tint:#edf3fc;--text:#202020;--muted:#4a4a4a;--line:#e5e5e5;--surface:#fff;--background:#f1f1f1;--warning:#fff1d9;--success:#e4f5ed;--success-strong:#178457;--danger:#fce7e8;--radius:16px}
    *{box-sizing:border-box}body{margin:0;background:var(--background);color:var(--text);font-family:Poppins,Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;line-height:1.5}main{width:min(100%,720px);margin:0 auto;padding:24px 20px 48px}.test-banner{margin:0 0 20px;padding:12px 16px;border-radius:12px;background:var(--warning);font-size:13px;font-weight:700;text-align:center}.brand{display:flex;align-items:center;gap:12px;margin-bottom:32px}.logo{width:48px;height:48px;object-fit:contain;border-radius:12px}.brand-name{font-size:18px;font-weight:600}.eyebrow{margin:0 0 8px;color:var(--primary);font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}h1{margin:0;font-size:28px;line-height:34px}h2{margin:32px 0 16px;font-size:20px;line-height:24px}.summary{display:grid;grid-template-columns:1fr 1fr;gap:16px 12px;margin-top:24px;padding:20px;background:var(--surface);border-radius:var(--radius)}.summary .stay{grid-column:1/-1}.summary div{display:grid;gap:2px}.summary dt{color:var(--muted);font-size:12px}.summary dd{margin:0;font-weight:600}.summary .nights dd{color:var(--primary);font-size:22px;font-weight:800;line-height:1.2}.status{margin:20px 0 0;padding:16px;border-radius:12px;background:var(--primary-tint);font-weight:500}.status.expired{background:var(--warning)}.status.accepted{background:var(--success)}.status.revoked{background:var(--danger)}.offer-form,.offer-list{display:grid;gap:16px}.option-card{display:block;overflow:hidden;background:var(--surface);border:2px solid transparent;border-radius:var(--radius)}.option-card:has(input:checked){border-color:var(--primary)}.room-gallery{display:grid;gap:0;background:var(--surface)}.room-hero{position:relative;display:block;overflow:hidden;background:var(--line)}.room-hero img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .2s ease}.room-hero:hover img{transform:scale(1.02)}.gallery-count{position:absolute;right:12px;bottom:12px;padding:6px 10px;border-radius:999px;background:rgba(20,20,20,.78);color:#fff;font-size:12px;font-weight:700}.room-thumbnails{display:flex;gap:8px;overflow-x:auto;padding:8px;scroll-snap-type:x mandatory;scrollbar-width:thin}.room-thumb{flex:0 0 84px;overflow:hidden;border:2px solid transparent;border-radius:8px;scroll-snap-align:start}.room-thumb.is-active{border-color:var(--primary)}.room-thumb img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}.photo-lightbox{display:none;position:fixed;z-index:1000;inset:0;place-items:center;padding:16px}.photo-lightbox:target{display:grid}.photo-backdrop{position:absolute;inset:0;background:rgba(10,14,20,.94)}.photo-stage{position:relative;z-index:1;display:grid;width:min(100%,1100px);max-height:calc(100vh - 32px);overflow:hidden;border-radius:14px;background:#101318;box-shadow:0 24px 80px rgba(0,0,0,.5)}.photo-stage>img{display:block;width:100%;max-height:calc(100vh - 96px);object-fit:contain}.photo-toolbar{display:flex;justify-content:space-between;gap:16px;padding:14px 18px;color:#fff;font-size:14px}.photo-close,.photo-nav{position:absolute;display:grid;place-items:center;color:#fff;text-decoration:none;background:rgba(0,0,0,.62);backdrop-filter:blur(6px)}.photo-close{top:12px;right:12px;width:42px;height:42px;border-radius:50%;font-size:28px}.photo-nav{top:50%;width:46px;height:64px;border-radius:10px;font-size:42px;line-height:1;transform:translateY(-50%)}.photo-prev{left:12px}.photo-next{right:12px}.option-content{display:grid;gap:10px;padding:20px;cursor:pointer}.option-select{display:flex;align-items:center;gap:8px;color:var(--primary);font-size:14px;font-weight:600}.option-select input{width:20px;height:20px;accent-color:var(--primary)}.room-name{font-size:20px;line-height:24px}.description{color:var(--muted);font-size:14px}.room-facts,.amenities{display:flex;flex-wrap:wrap;gap:8px}.room-facts span,.amenities span{padding:5px 9px;border-radius:999px;background:#f3f5f7;color:var(--muted);font-size:12px}.amenities span{background:var(--primary-tint);color:#24518b}.plan{display:grid;gap:2px;padding-top:4px;color:var(--muted);font-size:14px}.plan strong{color:var(--text);font-size:14px}.price{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:6px;padding-top:14px;border-top:1px solid var(--line);font-size:22px;font-weight:700}.price small{color:var(--muted);font-size:12px;font-weight:400}button{width:100%;min-height:54px;border:0;border-radius:12px;background:var(--primary);color:#fff;font:600 14px Poppins,Inter,sans-serif;cursor:pointer}button:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid #202020;outline-offset:3px}.empty{padding:20px;background:var(--surface);border-radius:var(--radius)}.confirmation{padding:28px 20px;border-radius:24px;background:var(--surface);box-shadow:0 18px 48px rgba(26,39,58,.08);text-align:center}.confirmation-icon{display:grid;width:72px;height:72px;margin:0 auto 22px;place-items:center;border-radius:50%;background:var(--success);color:var(--success-strong);font-size:36px;font-weight:800}.confirmation .eyebrow{color:var(--success-strong)}.confirmation-lead{max-width:500px;margin:14px auto 0;color:var(--muted);font-size:17px}.reply-time{display:inline-flex;margin:20px 0 0;padding:7px 12px;border-radius:999px;background:var(--success);color:var(--success-strong);font-size:13px;font-weight:700}.confirmation .summary{text-align:left;background:#f7f8fa}.next-steps{display:grid;gap:0;margin:24px 0 0;padding:0;text-align:left;list-style:none}.next-steps li{position:relative;display:grid;grid-template-columns:38px 1fr;align-items:center;gap:12px;min-height:54px}.next-steps li:not(:last-child):after{content:"";position:absolute;left:18px;top:42px;width:2px;height:24px;background:var(--line)}.next-steps span{display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:#f0f2f5;color:var(--muted);font-size:14px;font-weight:800}.next-steps .done span{background:var(--success);color:var(--success-strong)}.next-steps .current span{background:var(--primary);color:#fff}.next-steps .current strong{color:var(--primary)}.confirmation-next{margin:24px 0 0;padding:16px;border-radius:12px;background:var(--primary-tint);font-weight:600}.confirmation-close{margin:14px 0 0;color:var(--muted);font-size:13px}@media(min-width:640px){main{padding-top:40px}.summary{grid-template-columns:1.6fr .8fr .6fr;align-items:end}.summary .stay{grid-column:auto}.room-hero img{aspect-ratio:16/9}.room-thumb{flex-basis:104px}.confirmation{padding:40px}}
  </style>
</head>
<body><main>
  <header class="brand"><img class="logo" src="https://cdn.example.com/logo.png" alt=""><span class="brand-name">Hotel Sole</span></header>
  <p class="eyebrow">La sua proposta di soggiorno</p>
  <h1>Gentile Anna,</h1>
  <dl class="summary"><div class="stay"><dt>Soggiorno</dt><dd>10 gennaio 2027 – 12 gennaio 2027</dd></div><div><dt>Ospiti</dt><dd>2 adulti, 1 bambino</dd></div><div class="nights"><dt>Durata del soggiorno</dt><dd>2 notti</dd></div></dl>
  <p class="status active">Questa proposta è disponibile.</p>
  <h2>Hotel Sole</h2>
  <form method="post" action="/o/opaque-token/accept" class="offer-form"><article class="option-card" id="option-0">
        <span class="room-gallery">
      <a class="room-hero" href="#photo-0-0" aria-label="Apri la foto 1 di 5"><img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — camera da letto"><span class="gallery-count">5 foto</span></a>
      <span class="room-thumbnails" aria-label="5 foto"><a class="room-thumb is-active" href="#photo-0-0" aria-label="Apri la foto 1 di 5"><img src="https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — camera da letto"></a><a class="room-thumb" href="#photo-0-1" aria-label="Apri la foto 2 di 5"><img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — area soggiorno" loading="lazy"></a><a class="room-thumb" href="#photo-0-2" aria-label="Apri la foto 3 di 5"><img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — dettaglio" loading="lazy"></a><a class="room-thumb" href="#photo-0-3" aria-label="Apri la foto 4 di 5"><img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — bagno" loading="lazy"></a><a class="room-thumb" href="#photo-0-4" aria-label="Apri la foto 5 di 5"><img src="https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&amp;fit=crop&amp;w=1200&amp;q=85" alt="Camera Doppia — vista" loading="lazy"></a></span>
    </span><span class="photo-lightbox" id="photo-0-0" role="dialog" aria-modal="true" aria-label="Apri la foto 1 di 5">
