NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_BASE_URL=http://localhost:4000
# Public web app URL used in password reset emails (HTTPS in production).
APP_BASE_URL=http://localhost:8081
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/connections/google/oauth/callback
# Comma-separated OAuth client IDs accepted in Google ID-token aud claims (web/iOS/Android).
GOOGLE_AUTH_CLIENT_IDS=
# Comma-separated Apple bundle IDs or Services IDs accepted in Apple ID-token aud claims.
APPLE_AUTH_CLIENT_IDS=
WAHA_BASE_URL=
WAHA_API_KEY=
PLATFORM_ADMIN_EMAILS=
EXPO_ACCESS_TOKEN=
# Platform sender for staff notifications and password recovery.
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_NAME=Hotel Automation
DELIVERY_WORKER_ENABLED=false
DELIVERY_WORKER_INTERVAL_MS=5000
DELIVERY_WORKER_MAX_ATTEMPTS=5

# Run the contact worker as a separate process: npm run dev:clients
CLIENT_WORKER_INTERVAL_MS=30000
CLIENT_WORKER_BATCH_SIZE=25

# Optional Signal Monitoring. Blank keys disable telemetry. Never use a dashboard password.
SIGNAL_ENDPOINT=http://127.0.0.1:3001/api/ingest
# Separate write-only keys from the SAME Signal project/environment as the client.
# NODE_ENV selects the server key; production never falls back to development.
SIGNAL_WRITE_KEY_DEVELOPMENT=
SIGNAL_WRITE_KEY_PRODUCTION=
# Separate PUBLIC write-only keys for booking widgets, offers, legal/startup pages.
# Use the same Signal project/environment as server and Expo; never expose the server key.
SIGNAL_PUBLIC_WRITE_KEY_DEVELOPMENT=
SIGNAL_PUBLIC_WRITE_KEY_PRODUCTION=
SIGNAL_RELEASE=0.1.0
# Deployed API and worker commit/release; default to SIGNAL_RELEASE when blank.
SIGNAL_API_RELEASE=
SIGNAL_WORKER_RELEASE=
