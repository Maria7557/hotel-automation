EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# Web OAuth client ID. Used by Google Identity Services on web and as the native token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID and its reversed form for the native URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
