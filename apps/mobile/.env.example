EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_EAS_PROJECT_ID=
# Web OAuth client ID. Used by Google Identity Services on web and as the native token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID and its reversed form for the native URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# Customer-facing support contacts. Phone and WhatsApp should include the country code.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=support@chatsocials.app
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_SUPPORT_TELEGRAM=
