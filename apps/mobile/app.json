{
  "expo": {
    "name": "Hotel",
    "slug": "hotel-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F9FB",
    "primaryColor": "#1769FF",
    "plugins": ["expo-secure-store", "expo-apple-authentication", "expo-notifications"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hotel.staff",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hotel.staff",
      "adaptiveIcon": {
        "backgroundColor": "#1769FF"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
