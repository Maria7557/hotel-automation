# Generate every secret independently. Never commit the real .env file.
WAHA_API_KEY=replace-with-a-long-random-api-key
WAHA_DASHBOARD_USERNAME=replace-with-a-private-admin-name
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password

WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=False
WAHA_PRINT_QR=False
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_NAMESPACE=all
WAHA_WORKER_RESTART_SESSIONS=True
TZ=Europe/Rome
